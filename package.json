{
  "name": "vigie",
  "version": "0.1.0",
  "description": "A lightweight, local-only dashboard to browse your Claude Code sessions (desktop app, CLI, VS Code).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vigie": "dist/cli.js"
  },
  "files": [
    "dist",
    "ui"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "dev": "node --watch src/cli.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepare": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "dashboard",
    "sessions",
    "agents"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}

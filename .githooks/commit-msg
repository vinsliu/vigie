#!/bin/sh
# Local check of the commit message. Enable it once per clone with:  npm run hooks
# It mirrors what CI checks on pull request titles.

file="$1"
subject=$(sed -n '1p' "$file")

# Merge, revert and fixup commits are generated by git itself.
case "$subject" in
  "Merge "* | "Revert "* | "fixup!"* | "squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|release)(\([a-z0-9._-]+\))?!?: .+'
if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: the first line must follow Conventional Commits, for example:" >&2
  echo "    feat(ui): add a period filter" >&2
  echo "    fix: close the drawer on a click outside" >&2
  echo "  types: feat fix docs style refactor perf test build ci chore revert release" >&2
  exit 1
fi

# This project does not credit an AI assistant as a co-author.
if grep -Eiq '^[^[:alnum:]]*(co-authored-by|generated with).*(claude|anthropic)' "$file"; then
  echo "commit-msg: no co-author or 'generated with' line for Claude in this repository." >&2
  exit 1
fi
